{
  "name": "@ecommaps/ai-sales-agent",
  "version": "0.1.0",
  "description": "Ecommaps sales agent kit (server tools + React UI).",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.mjs",
      "require": "./dist/next/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/server/index.ts src/react/index.ts src/next/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/server/index.ts src/react/index.ts src/next/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@ecommaps/client": "^1.4.1",
    "@ecommaps/storefront-kit": "^0.1.0",
    "ai": "^6.0.116",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.2",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/labobankcom/ecommaps-ai-sales-agent.git"
  },
  "bugs": {
    "url": "https://github.com/labobankcom/ecommaps-ai-sales-agent/issues"
  },
  "homepage": "https://github.com/labobankcom/ecommaps-ai-sales-agent#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.28.0"
}
